<%- include('partials/header') %>

<div class="p-5 mb-4 hero-bg rounded-3 text-center">
  <h1 class="display-5 fw-bold">Encontre a guitarra ideal para o seu nível</h1>
  <p class="col-md-8 fs-4 mx-auto">Guia completo com recomendações de preços, modelos e características divididos por nível de experiência.</p>
  
  <!-- BARRA DE PESQUISA COM API -->
  <div class="d-flex justify-content-center my-4 col-md-8 mx-auto">
    <input id="campo-busca" class="form-control form-control-lg me-2" type="search" placeholder="Pesquisar por nome ou modelo via API...">
    <button id="btn-busca" class="btn btn-warning btn-lg fw-bold" type="button">Buscar</button>
  </div>
</div>

<h2 class="mb-3" id="titulo-resultados">Destaques</h2>

<!-- CONTAINER DE GUITARRAS -->
<div class="row" id="container-guitarras">
  <% if (typeof guitarras !== 'undefined' && guitarras && guitarras.length > 0) { %>
    <% guitarras.forEach(guitarra => { %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm card-guitar">
          <img src="<%= guitarra.imagem %>" class="card-img-top" style="height: 200px; object-fit: cover;" alt="<%= guitarra.nome %>">
          <div class="card-body d-flex flex-column justify-content-between">
            <div>
              <span class="badge bg-secondary text-uppercase mb-2"><%= guitarra.nivel %></span>
              <h5 class="card-title"><%= guitarra.nome %></h5>
              <p class="card-text text-muted"><%= guitarra.descricao %></p>
              <p class="fw-bold text-success fs-5">R$ <%= guitarra.preco ? guitarra.preco.toFixed(2) : '0.00' %></p>
            </div>

            <!-- BOTÕES DE REAÇÃO COM BOTÃO ÚNICO -->
            <div class="border-top pt-3 mt-2 d-flex justify-content-between align-items-center">
              <button type="button" id="btn-like-<%= guitarra.id %>" onclick="darReacao('<%= guitarra.id %>', 'like')" class="btn btn-sm btn-outline-success">
                👍 <span id="likes-<%= guitarra.id %>"><%= guitarra.likes || 0 %></span>
              </button>
              <button type="button" id="btn-dislike-<%= guitarra.id %>" onclick="darReacao('<%= guitarra.id %>', 'dislike')" class="btn btn-sm btn-outline-danger">
                👎 <span id="dislikes-<%= guitarra.id %>"><%= guitarra.dislikes || 0 %></span>
              </button>
              <button type="button" class="btn btn-sm btn-outline-secondary" onclick="alternarComentarios('<%= guitarra.id %>')">
                💬 Comentários
              </button>
            </div>

            <!-- SEÇÃO DE COMENTÁRIOS -->
            <div id="secao-comentarios-<%= guitarra.id %>" class="mt-3 border-top pt-2 d-none text-start">
              <h6 class="fw-bold mb-2">Comentários:</h6>
              <div id="lista-comentarios-<%= guitarra.id %>" class="mb-3 style-scroll" style="max-height: 150px; overflow-y: auto;">
                <p class="text-muted small">Carregando comentários...</p>
              </div>

              <div class="input-group input-group-sm mb-2">
                <input type="text" id="autor-<%= guitarra.id %>" class="form-control" placeholder="Seu nome">
              </div>
              <div class="input-group input-group-sm mb-2">
                <input type="text" id="texto-<%= guitarra.id %>" class="form-control" placeholder="Escreva um comentário...">
                <button class="btn btn-primary" type="button" onclick="enviarComentario('<%= guitarra.id %>')">Enviar</button>
              </div>
            </div>

          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="col-12">
      <p class="alert alert-warning">Nenhuma guitarra cadastrada.</p>
    </div>
  <% } %>
</div>

<script>
  const campoBusca = document.getElementById('campo-busca');
  const btnBusca = document.getElementById('btn-busca');
  const containerGuitarras = document.getElementById('container-guitarras');
  const tituloResultados = document.getElementById('titulo-resultados');

  // Inicializa o destaque visual dos botões salvos no localStorage
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[id^="btn-like-"]').forEach(btn => {
      const id = btn.id.replace('btn-like-', '');
      const votoSalvo = localStorage.getItem(`voto_guitarra_${id}`);
      if (votoSalvo) atualizarAparenciaBotoes(id, votoSalvo);
    });
  });

  // Função para Like / Dislike único com LocalStorage
  async function darReacao(id, tipo) {
    const chaveVoto = `voto_guitarra_${id}`;
    const votoAnterior = localStorage.getItem(chaveVoto);

    // Se clicar no mesmo botão já marcado, cancela o voto
    if (votoAnterior === tipo) {
      await enviarReacaoAPI(id, tipo, 'remover');
      localStorage.removeItem(chaveVoto);
      atualizarAparenciaBotoes(id, null);
      return;
    }

    // Se já tinha votado no botão oposto, remove o voto anterior
    if (votoAnterior) {
      await enviarReacaoAPI(id, votoAnterior, 'remover');
    }

    // Adiciona o novo voto
    const dados = await enviarReacaoAPI(id, tipo, 'adicionar');
    if (dados) {
      localStorage.setItem(chaveVoto, tipo);
      atualizarAparenciaBotoes(id, tipo);
    }
  }

  // Faz a requisição à API
  async function enviarReacaoAPI(id, tipo, acao) {
    try {
      const resposta = await fetch(`/guitarra/${id}/reacao`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo: tipo, acao: acao })
      });
      const dados = await resposta.json();
      
      const elLikes = document.getElementById(`likes-${id}`);
      const elDislikes = document.getElementById(`dislikes-${id}`);

      if (elLikes) elLikes.innerText = dados.likes;
      if (elDislikes) elDislikes.innerText = dados.dislikes;

      return dados;
    } catch (erro) {
      console.error('Erro ao registrar reação:', erro);
    }
  }

  // Atualiza a cor dos botões
  function atualizarAparenciaBotoes(id, tipoVoto) {
    const btnLike = document.getElementById(`btn-like-${id}`);
    const btnDislike = document.getElementById(`btn-dislike-${id}`);

    if (!btnLike || !btnDislike) return;

    btnLike.className = 'btn btn-sm btn-outline-success';
    btnDislike.className = 'btn btn-sm btn-outline-danger';

    if (tipoVoto === 'like') {
      btnLike.className = 'btn btn-sm btn-success text-white';
    } else if (tipoVoto === 'dislike') {
      btnDislike.className = 'btn btn-sm btn-danger text-white';
    }
  }

  // Alternar comentários
  function alternarComentarios(id) {
    const secao = document.getElementById(`secao-comentarios-${id}`);
    if (secao.classList.contains('d-none')) {
      secao.classList.remove('d-none');
      carregarComentarios(id);
    } else {
      secao.classList.add('d-none');
    }
  }

  // Carregar comentários
  async function carregarComentarios(id) {
    const lista = document.getElementById(`lista-comentarios-${id}`);
    try {
      const res = await fetch(`/api/guitarra/${id}/comentarios`);
      const comentarios = await res.json();

      lista.innerHTML = '';
      if (comentarios.length === 0) {
        lista.innerHTML = '<p class="text-muted small">Nenum comentário ainda. Seja o primeiro!</p>';
        return;
      }

      comentarios.forEach(c => {
        lista.innerHTML += `
          <div class="bg-light p-2 rounded mb-1 border">
            <strong class="d-block small text-dark">${c.autor}</strong>
            <span class="small text-secondary">${c.texto}</span>
          </div>
        `;
      });
    } catch (err) {
      lista.innerHTML = '<p class="text-danger small">Erro ao carregar comentários.</p>';
    }
  }

  // Enviar comentário
  async function enviarComentario(id) {
    const autorInput = document.getElementById(`autor-${id}`);
    const textoInput = document.getElementById(`texto-${id}`);

    const autor = autorInput.value.trim();
    const texto = textoInput.value.trim();

    if (!autor || !texto) {
      alert('Por favor, preencha o seu nome e o comentário.');
      return;
    }

    try {
      const res = await fetch(`/api/guitarra/${id}/comentarios`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ autor, texto })
      });

      if (res.ok) {
        autorInput.value = '';
        textoInput.value = '';
        carregarComentarios(id);
      }
    } catch (err) {
      console.error('Erro ao enviar comentário:', err);
    }
  }

  // Busca via API
  async function buscarGuitarrasAPI() {
    const termo = campoBusca.value.trim();
    tituloResultados.innerText = termo ? `Resultados para "${termo}" (via API)` : 'Destaques';

    try {
      const resposta = await fetch(`/api/guitarras/busca?q=${encodeURIComponent(termo)}`);
      const guitarras = await resposta.json();

      containerGuitarras.innerHTML = '';

      if (guitarras.length === 0) {
        containerGuitarras.innerHTML = '<div class="col-12"><p class="alert alert-warning">Nenhuma guitarra encontrada.</p></div>';
        return;
      }

      guitarras.forEach(guitarra => {
        const cardHTML = `
          <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm card-guitar">
              <img src="${guitarra.imagem}" class="card-img-top" style="height: 200px; object-fit: cover;" alt="${guitarra.nome}">
              <div class="card-body d-flex flex-column justify-content-between">
                <div>
                  <span class="badge bg-secondary text-uppercase mb-2">${guitarra.nivel}</span>
                  <h5 class="card-title">${guitarra.nome}</h5>
                  <p class="card-text text-muted">${guitarra.descricao}</p>
                  <p class="fw-bold text-success fs-5">R$ ${guitarra.preco ? guitarra.preco.toFixed(2) : '0.00'}</p>
                </div>

                <div class="border-top pt-3 mt-2 d-flex justify-content-between align-items-center">
                  <button type="button" id="btn-like-${guitarra.id}" onclick="darReacao('${guitarra.id}', 'like')" class="btn btn-sm btn-outline-success">
                    👍 <span id="likes-${guitarra.id}">${guitarra.likes || 0}</span>
                  </button>
                  <button type="button" id="btn-dislike-${guitarra.id}" onclick="darReacao('${guitarra.id}', 'dislike')" class="btn btn-sm btn-outline-danger">
                    👎 <span id="dislikes-${guitarra.id}">${guitarra.dislikes || 0}</span>
                  </button>
                  <button type="button" class="btn btn-sm btn-outline-secondary" onclick="alternarComentarios('${guitarra.id}')">
                    💬 Comentários
                  </button>
                </div>

                <div id="secao-comentarios-${guitarra.id}" class="mt-3 border-top pt-2 d-none text-start">
                  <h6 class="fw-bold mb-2">Comentários:</h6>
                  <div id="lista-comentarios-${guitarra.id}" class="mb-3 style-scroll" style="max-height: 150px; overflow-y: auto;">
                    <p class="text-muted small">Carregando comentários...</p>
                  </div>

                  <div class="input-group input-group-sm mb-2">
                    <input type="text" id="autor-${guitarra.id}" class="form-control" placeholder="Seu nome">
                  </div>
                  <div class="input-group input-group-sm mb-2">
                    <input type="text" id="texto-${guitarra.id}" class="form-control" placeholder="Escreva um comentário...">
                    <button class="btn btn-primary" type="button" onclick="enviarComentario('${guitarra.id}')">Enviar</button>
                  </div>
                </div>

              </div>
            </div>
          </div>
        `;
        containerGuitarras.innerHTML += cardHTML;
        
        // Aplica destaque se já votou nesta guitarra
        const votoSalvo = localStorage.getItem(`voto_guitarra_${guitarra.id}`);
        if (votoSalvo) atualizarAparenciaBotoes(guitarra.id, votoSalvo);
      });

    } catch (erro) {
      console.error('Erro ao chamar API:', erro);
    }
  }

  btnBusca.addEventListener('click', buscarGuitarrasAPI);
  campoBusca.addEventListener('input', buscarGuitarrasAPI);
</script>

<%- include('partials/footer') %>