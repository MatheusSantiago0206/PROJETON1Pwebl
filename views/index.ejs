<%- include('partials/header') %>

<div class="p-5 mb-4 hero-bg rounded-3 text-center">
  <h1 class="display-5 fw-bold">Encontre a guitarra ideal para o seu nível</h1>
  <p class="col-md-8 fs-4 mx-auto">Guia completo com recomendações de preços, modelos e características divididos por nível de experiência.</p>
  
  <!-- BARRA DE PESQUISA COM API -->
  <div class="d-flex justify-content-center my-4 col-md-8 mx-auto">
    <input id="campo-busca" class="form-control form-control-lg me-2" type="search" placeholder="Pesquisar por nome ou modelo via API...">
    <button id="btn-busca" class="btn btn-warning btn-lg fw-bold" type="button">Buscar</button>
  </div>
</div>

<h2 class="mb-3" id="titulo-resultados">Destaques</h2>

<!-- CONTAINER DE GUITARRAS -->
<div class="row" id="container-guitarras">
  <% if (typeof guitarras !== 'undefined' && guitarras && guitarras.length > 0) { %>
    <% guitarras.forEach(guitarra => { %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm card-guitar">
          <img src="<%= guitarra.imagem %>" class="card-img-top" style="height: 200px; object-fit: cover;" alt="<%= guitarra.nome %>">
          <div class="card-body d-flex flex-column justify-content-between">
            <div>
              <span class="badge bg-secondary text-uppercase mb-2"><%= guitarra.nivel %></span>
              <h5 class="card-title"><%= guitarra.nome %></h5>
              <p class="card-text text-muted"><%= guitarra.descricao %></p>
              <p class="fw-bold text-success fs-5">R$ <%= guitarra.preco ? guitarra.preco.toFixed(2) : '0.00' %></p>
            </div>

            <!-- BOTÕES COM ONCLICK (SEM FORMULÁRIO) -->
            <div class="border-top pt-3 mt-2 d-flex justify-content-between align-items-center">
              <button type="button" onclick="darReacao('<%= guitarra.id %>', 'like')" class="btn btn-sm btn-outline-success">
                👍 <span id="likes-<%= guitarra.id %>"><%= guitarra.likes || 0 %></span>
              </button>
              <button type="button" onclick="darReacao('<%= guitarra.id %>', 'dislike')" class="btn btn-sm btn-outline-danger">
                👎 <span id="dislikes-<%= guitarra.id %>"><%= guitarra.dislikes || 0 %></span>
              </button>
            </div>

          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="col-12">
      <p class="alert alert-warning">Nenhuma guitarra cadastrada.</p>
    </div>
  <% } %>
</div>

<script>
  const campoBusca = document.getElementById('campo-busca');
  const btnBusca = document.getElementById('btn-busca');
  const containerGuitarras = document.getElementById('container-guitarras');
  const tituloResultados = document.getElementById('titulo-resultados');

  // Função que chama a API via fetch e atualiza o número sem sair da página
  async function darReacao(id, tipo) {
    try {
      const resposta = await fetch(`/guitarra/${id}/reacao`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tipo: tipo })
      });
      const dados = await resposta.json();
      
      const elLikes = document.getElementById(`likes-${id}`);
      const elDislikes = document.getElementById(`dislikes-${id}`);

      if (elLikes) elLikes.innerText = dados.likes;
      if (elDislikes) elDislikes.innerText = dados.dislikes;
    } catch (erro) {
      console.error('Erro ao registrar reação:', erro);
    }
  }

  // Busca em tempo real via API
  async function buscarGuitarrasAPI() {
    const termo = campoBusca.value.trim();
    tituloResultados.innerText = termo ? `Resultados para "${termo}" (via API)` : 'Destaques';

    try {
      const resposta = await fetch(`/api/guitarras/busca?q=${encodeURIComponent(termo)}`);
      const guitarras = await resposta.json();

      containerGuitarras.innerHTML = '';

      if (guitarras.length === 0) {
        containerGuitarras.innerHTML = '<div class="col-12"><p class="alert alert-warning">Nenhuma guitarra encontrada para essa busca.</p></div>';
        return;
      }

      guitarras.forEach(guitarra => {
        const cardHTML = `
          <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm card-guitar">
              <img src="${guitarra.imagem}" class="card-img-top" style="height: 200px; object-fit: cover;" alt="${guitarra.nome}">
              <div class="card-body d-flex flex-column justify-content-between">
                <div>
                  <span class="badge bg-secondary text-uppercase mb-2">${guitarra.nivel}</span>
                  <h5 class="card-title">${guitarra.nome}</h5>
                  <p class="card-text text-muted">${guitarra.descricao}</p>
                  <p class="fw-bold text-success fs-5">R$ ${guitarra.preco ? guitarra.preco.toFixed(2) : '0.00'}</p>
                </div>
                <div class="border-top pt-3 mt-2 d-flex justify-content-between align-items-center">
                  <button type="button" onclick="darReacao('${guitarra.id}', 'like')" class="btn btn-sm btn-outline-success">
                    👍 <span id="likes-${guitarra.id}">${guitarra.likes || 0}</span>
                  </button>
                  <button type="button" onclick="darReacao('${guitarra.id}', 'dislike')" class="btn btn-sm btn-outline-danger">
                    👎 <span id="dislikes-${guitarra.id}">${guitarra.dislikes || 0}</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        `;
        containerGuitarras.innerHTML += cardHTML;
      });

    } catch (erro) {
      console.error('Erro ao chamar API:', erro);
    }
  }

  btnBusca.addEventListener('click', buscarGuitarrasAPI);
  campoBusca.addEventListener('input', buscarGuitarrasAPI);
</script>

<%- include('partials/footer') %>