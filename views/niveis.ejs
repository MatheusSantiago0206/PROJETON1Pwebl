<%- include('partials/header') %>

<div class="py-3">
  <h1 class="mb-4">Níveis de Experiência</h1>
  <p class="lead">Escolha o seu nível de habilidade para ver as guitarras mais recomendadas:</p>
  
  <div class="row g-4 mt-2">
    <% Object.keys(niveis).forEach(chave => { %>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm border-0 bg-white">
          <div class="card-body d-flex flex-column justify-content-between text-center p-4">
            <h4 class="card-title text-primary font-weight-bold mb-3"><%= niveis[chave] %></h4>
            <a href="/niveis/<%= chave %>" class="btn btn-outline-dark fw-bold mt-3">Ver Guitarras</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>